# URL base da API para o frontend. Deixe como '/api' para rotas relativas ao servidor Express.
VITE_API_BASE_URL=/api

# Ambiente Django (docker-compose.yml). DJANGO_ALLOWED_HOSTS não precisa
# ser definido — o docker-compose.yml já usa o valor certo por padrão
# ("backend", o nome do serviço na rede interna do Docker; o Django nunca
# é exposto direto, só via proxy do frontend). Só descomente DJANGO_DEBUG
# para rodar localmente via docker-compose com o Django em modo debug —
# nunca deixe True em produção:
# DJANGO_DEBUG=True

# Configurações de Servidor de E-mail SMTP (Microsoft Office 365 / Outlook / Exchange)
# Consumidas pelo backend Django (backend_django/config/settings.py) — a senha
# real vai em secrets/smtp_password.txt, nunca aqui.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=seu.email@pc.ce.gov.br

# Caso utilize Autenticação Moderna (OAuth2) do Office 365 / Azure AD:
# SMTP_OAUTH_CLIENT_ID=seu_client_id_azure
# SMTP_OAUTH_CLIENT_SECRET=seu_client_secret_azure
# SMTP_OAUTH_REFRESH_TOKEN=seu_refresh_token_azure
